# ── Django ────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production-use-django-get-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────
# DB_PASSWORD is used by docker-compose to set POSTGRES_PASSWORD and build DATABASE_URL
DB_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql://web_mail_user:changeme_strong_password@localhost:5432/web_mail_db
DB_NAME=web_mail_db
DB_USER=web_mail_user
DB_HOST=localhost
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2

# ── Email relay (pick one) ─────────────────────────────────────────────
# Option A — AWS SES (primary; requires SES production access + SNS bounce/complaint topic)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# Option B — SendGrid (alternative to SES)
SENDGRID_API_KEY=

# Option C — Generic SMTP relay (fallback if neither SES nor SendGrid is configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ── Security ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Random secret used to sign tracking tokens and unsubscribe URLs — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SIGNING_KEY=change-me-for-tracking-token-signing

# ── 2FA ───────────────────────────────────────────────────────────────
OTP_TOTP_ISSUER=WebMail

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Sentry (prod only) ────────────────────────────────────────────────
SENTRY_DSN=

# ── Frontend ──────────────────────────────────────────────────────────
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_BASE_URL=http://localhost:3000

# ── URLs (must be set to your public domain in production) ────────────
# Used to build absolute links: tracking pixels, click redirects, unsubscribe URLs
BASE_URL=http://localhost:8000
TRACKING_BASE_URL=http://localhost:8000

# ── Compliance ────────────────────────────────────────────────────────
# CAN-SPAM §5(a)(6): physical mailing address injected into every outgoing email footer.
# Replace with your real legal address before going live.
PHYSICAL_ADDRESS=123 Main St, Suite 100, San Francisco, CA 94105, USA

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
DJANGO_LOG_LEVEL=WARNING
CELERY_LOG_LEVEL=INFO

# ── Monitoring ────────────────────────────────────────────────────────
# Bearer token required to scrape GET /metrics/ — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
METRICS_TOKEN=

# ── Gunicorn ──────────────────────────────────────────────────────────
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=120

# ── Celery Flower (task monitor UI — never expose port 5555 publicly) ─
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-flower-password

# ── GeoIP2 (geolocation tracking) ────────────────────────────────────
# Free MaxMind license key — sign up at https://www.maxmind.com/en/geolite2/signup
# Used at Docker build time to download GeoLite2-City.mmdb into /app/geoip/
# If left empty, geo tracking silently returns {} (non-fatal)
MAXMIND_LICENSE_KEY=
GEOIP_PATH=/app/geoip

# ── First-time deploy superuser ──────────────────────────────────────
# Used by deploy/03_deploy.sh to create the initial admin account.
# Change the password immediately after first login.
SUPERUSER_EMAIL=admin@yourdomain.com
SUPERUSER_PASSWORD=CHANGE_ME_IMMEDIATELY_AFTER_FIRST_LOGIN
