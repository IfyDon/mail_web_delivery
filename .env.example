# ── Django ────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production-use-django-get-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://web_mail_user:changeme_strong_password@localhost:5432/web_mail_db
DB_NAME=web_mail_db
DB_USER=web_mail_user
DB_PASSWORD=changeme_strong_password
DB_HOST=localhost
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Email relay (pick one) ─────────────────────────────────────────────
# AWS SES
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# SendGrid (alternative)
SENDGRID_API_KEY=

# ── Security ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SIGNING_KEY=change-me-for-tracking-token-signing

# ── 2FA ───────────────────────────────────────────────────────────────
OTP_TOTP_ISSUER=WebMail

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Sentry (prod only) ────────────────────────────────────────────────
SENTRY_DSN=

# ── Frontend ──────────────────────────────────────────────────────────
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_BASE_URL=http://localhost:3000
