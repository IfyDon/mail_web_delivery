# =============================================================================
#  .env.production — Complete production environment variables
#
#  HOW TO USE:
#    cp deploy/.env.production .env
#    Fill in every value marked  ← SET THIS
#    Run: docker compose up -d
#
#  GENERATE SECRETS:
#    python3 -c "import secrets; print(secrets.token_hex(50))"
# =============================================================================


# ── Django core ──────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=False

# 50-char random hex — generate with: python3 -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=                                          # ← SET THIS

# Your public domain(s), comma-separated (no http://)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com      # ← SET THIS


# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# DB_PASSWORD is referenced by docker-compose for BOTH the postgres container
# and the DATABASE_URL connection string. Use a strong random password.
DB_PASSWORD=                                         # ← SET THIS (strong random password)

# Built automatically from DB_PASSWORD in docker-compose — do not change the format
DATABASE_URL=postgresql://web_mail_user:${DB_PASSWORD}@db:5432/web_mail_db

DB_NAME=web_mail_db
DB_USER=web_mail_user
DB_HOST=db
DB_PORT=5432


# ── Redis ─────────────────────────────────────────────────────────────────────
# These use the docker-compose service name "redis" as the host.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2


# ── Email relay ───────────────────────────────────────────────────────────────
# OPTION A: AWS SES (primary — recommended)
#   Get from: AWS Console → IAM → Create user with SES send permissions
#   Policy:  arn:aws:iam::aws:policy/AmazonSESFullAccess  (or least-privilege below)
#
#   Least-privilege SES policy:
#     {"Version":"2012-10-17","Statement":[{
#       "Effect":"Allow","Action":["ses:SendEmail","ses:SendRawEmail"],
#       "Resource":"*"
#     }]}
#
AWS_ACCESS_KEY_ID=                                   # ← SET THIS
AWS_SECRET_ACCESS_KEY=                               # ← SET THIS
AWS_SES_REGION=us-east-1                             # ← change if your SES region differs
AWS_SES_FROM_EMAIL=noreply@yourdomain.com            # ← SET THIS (must be SES-verified address)

# OPTION B: SendGrid (alternative — leave blank if using SES)
SENDGRID_API_KEY=

# OPTION C: Generic SMTP relay (fallback — leave blank if using SES or SendGrid)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true


# ── Security & token signing ─────────────────────────────────────────────────
# Used to sign tracking pixels, click URLs, and one-click unsubscribe tokens.
# Changing this invalidates all existing tracking links and unsubscribe tokens.
SIGNING_KEY=                                         # ← SET THIS (50-char random hex)

# CORS / CSRF — must match your exact public domain(s)
CORS_ALLOWED_ORIGINS=https://yourdomain.com          # ← SET THIS
CSRF_TRUSTED_ORIGINS=https://yourdomain.com          # ← SET THIS


# ── URLs ─────────────────────────────────────────────────────────────────────
# These MUST start with https:// in production.
BASE_URL=https://yourdomain.com                      # ← SET THIS
TRACKING_BASE_URL=https://yourdomain.com             # ← SET THIS
FRONTEND_BASE_URL=https://yourdomain.com             # ← SET THIS
REACT_APP_API_BASE_URL=https://yourdomain.com/api/v1 # ← SET THIS


# ── CAN-SPAM compliance ────────────────────────────────────────────────────────
# §5(a)(6): A valid physical postal address is REQUIRED in every commercial email.
# Use your real legal business address — this is a legal requirement.
PHYSICAL_ADDRESS=                                    # ← SET THIS (your real address)


# ── 2FA ───────────────────────────────────────────────────────────────────────
OTP_TOTP_ISSUER=WebMail                              # ← change to your product/brand name


# ── Stripe billing ────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys  (use LIVE keys, not test)
# Webhook secret: run deploy/06_stripe.sh or get from https://dashboard.stripe.com/webhooks
STRIPE_PUBLISHABLE_KEY=pk_live_                      # ← SET THIS
STRIPE_SECRET_KEY=sk_live_                           # ← SET THIS
STRIPE_WEBHOOK_SECRET=whsec_                         # ← SET THIS (from 06_stripe.sh output)


# ── Error tracking (Sentry) ───────────────────────────────────────────────────
# Create project at https://sentry.io → Settings → Projects → New Project → Django
# Then copy the DSN from Settings → Client Keys (DSN)
SENTRY_DSN=                                          # ← SET THIS (recommended for prod)


# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
DJANGO_LOG_LEVEL=WARNING
CELERY_LOG_LEVEL=INFO


# ── Monitoring ────────────────────────────────────────────────────────────────
# Bearer token required to scrape GET /metrics/
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
METRICS_TOKEN=                                       # ← SET THIS


# ── Gunicorn ──────────────────────────────────────────────────────────────────
# WEB_CONCURRENCY: set to (2 × CPU cores) + 1 for I/O-bound workloads
# For a 2-CPU VPS → 5 workers
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=120


# ── Celery Flower (task monitor) ──────────────────────────────────────────────
# Flower is bound to 127.0.0.1:5555 — access only via SSH tunnel.
# Use a strong password; this UI shows all queued/running tasks.
FLOWER_USER=admin
FLOWER_PASSWORD=                                     # ← SET THIS (strong password)


# ── Database backups (deploy/08_backup.sh) ────────────────────────────────────
# Local directory backups are written to before pruning. Defaults to APP_DIR/backups.
BACKUP_DIR=
# How many days of local backups to keep before deleting.
BACKUP_RETENTION_DAYS=14
# Optional: also copy each backup to this S3 bucket (uses the AWS CLI /
# credentials already installed by 01_server_setup.sh). Leave blank to skip.
BACKUP_S3_BUCKET=
